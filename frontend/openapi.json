    "/api/v1/analysis/{ticker}": {
      "get": {
        "tags": [
          "market"
        ],
        "summary": "Analyze Ticker",
        "description": "Return market signals and explicit unknown states for unavailable data.",
        "operationId": "analyze_ticker_api_v1_analysis__ticker__get",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ticker"
            }
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(1mo|3mo|6mo|1y|2y|5y)$",
              "default": "1y",
              "title": "Period"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
