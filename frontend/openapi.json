    "/api/v1/portfolio": {
      "get": {
        "tags": [
          "portfolio"
        ],
        "summary": "List Portfolio",
        "description": "Return current portfolio positions without presentation-layer coupling.",
        "operationId": "list_portfolio_api_v1_portfolio_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PortfolioPositionResponse"
                  },
                  "type": "array",
                  "title": "Response List Portfolio Api V1 Portfolio Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transactions": {
      "post": {
        "tags": [
          "transactions"
        ],
        "summary": "Record Transaction",
        "description": "Record a purchase or sale and return the resulting position.",
        "operationId": "record_transaction_api_v1_transactions_post",
