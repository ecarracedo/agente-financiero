  "components": {
    "schemas": {
      "AlertCheckResponse": {
        "properties": {
          "current_price": {
            "type": "string",
            "title": "Current Price"
          },
          "event": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TargetAlertEventResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "current_price",
          "event"
        ],
        "title": "AlertCheckResponse",
        "description": "Expose an alert evaluation with its canonical observed price."
      },
      "AlertIntent": {
        "type": "string",
        "enum": [
          "NEUTRAL",
          "STOP_LOSS",
          "BUY",
          "SELL"
        ],
        "title": "AlertIntent",
        "description": "Supported meanings for a configured target price."
      },
      "BibliographyCreateRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Title"
          },
          "author": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Author"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2100.0,
                "minimum": 1900.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "category": {
            "type": "string",
            "maxLength": 80,
            "title": "Category",
            "default": "General"
          },
          "link": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Link"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "author"
        ],
        "title": "BibliographyCreateRequest",
        "description": "Validate a bibliography resource and optional metadata."
      },
      "BibliographyItemResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "link": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Link"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "author",
          "year",
          "category",
          "link",
          "description"
        ],
        "title": "BibliographyItemResponse",
        "description": "Expose a bibliography resource and its optional metadata."
      },
      "ConfiguredResponse": {
        "properties": {
          "configured": {
            "type": "boolean",
            "title": "Configured"
          }
        },
        "type": "object",
        "required": [
          "configured"
        ],
        "title": "ConfiguredResponse",
        "description": "Acknowledge a successful alert configuration."
      },
      "CurrencyValuationResponse": {
        "properties": {
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "invested_value": {
            "type": "string",
            "title": "Invested Value"
          },
          "market_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Market Value"
          },
          "gain_loss": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gain Loss"
          },
          "gain_loss_percent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
