# URL the browser uses to reach the API.
#
# Development is single-origin, like production: point it at the Vite dev server
# so its proxy forwards `/api` to the backend, and set `VITE_PROXY_TARGET` to the
# backend origin the dev server should call.
VITE_API_BASE_URL=http://localhost:5173

# Backend origin the Vite dev server proxies `/api` to (`http://backend:8000`
# when the dev server runs inside Compose). Defaults to http://localhost:8000.
VITE_PROXY_TARGET=http://localhost:8000
