# PostgreSQL credentials for the Compose stack. Copy this file to `.env` and
# replace the password before running either flow.
POSTGRES_DB=financial_agent
POSTGRES_USER=financial_agent
POSTGRES_PASSWORD=replace-with-a-local-secret

# Published ports: backend API, built frontend, Vite dev server.
API_PORT=8000
WEB_PORT=3000
WEB_DEV_PORT=5173

# Origin the browser uses to reach the API. Nginx serves the built SPA and
# proxies `/api` on the same origin, so this is the frontend origin, and Vite
# bakes it into the image at build time.
VITE_API_BASE_URL=http://localhost:3000

# Agent settings. The agent is not deployed to AWS: `strands-agents` is used as
# a library and the model and region are read from the environment whenever an
# agent route exposes it. Nothing in this Compose stack consumes them yet.
AGENT_MODEL_ID=global.anthropic.claude-sonnet-4-6
AWS_REGION=us-west-2
