# PostgreSQL credentials for the Compose stack. Copy this file to `.env` and
# replace the password before running either flow.
POSTGRES_DB=financial_agent
POSTGRES_USER=financial_agent
POSTGRES_PASSWORD=replace-with-a-local-secret

# Published ports: built frontend, Vite dev server. The backend API is not
# published; it is reachable only through the frontend proxy.
WEB_PORT=3000
WEB_DEV_PORT=5173

# Origin the browser uses to reach the API. Nginx serves the built SPA and
# proxies `/api` on the same origin, so this is the frontend origin, and Vite
# bakes it into the image at build time.
VITE_API_BASE_URL=http://localhost:3000

# Agent settings. The agent is not deployed to AWS: `strands-agents` is used as
# a library and the model and region are read from the environment whenever an
# agent route exposes it. Nothing in this Compose stack consumes them yet.
AGENT_MODEL_ID=global.anthropic.claude-sonnet-4-6
AWS_REGION=us-west-2

# Single-user authentication. The user is seeded on first login from these
# values; the password is stored only as a scrypt hash in the database.
# AUTH_SECRET encrypts the TOTP secret at rest and must stay stable.
AUTH_USERNAME=ecarracedo
AUTH_EMAIL=ecarracedo@gmail.com
AUTH_PASSWORD=replace-with-a-strong-password
AUTH_SECRET=replace-with-a-long-random-secret
# Set to 1 once the app is served over HTTPS.
COOKIE_SECURE=0

# Optional alert email delivery. Leave SMTP_HOST empty to disable email:
# crossings will still appear in the in-app popup. When set, one email is sent
# per new crossing. AUTH_EMAIL is the sender and the default recipient; set
# ALERT_EMAIL_TO to deliver to a different address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 1 enables STARTTLS (use 0 only for a trusted local relay on port 25).
SMTP_USE_TLS=1
SMTP_TIMEOUT=10
ALERT_EMAIL_TO=
